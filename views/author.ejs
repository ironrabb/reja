<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- CSS -->
    <link rel="stylesheet" href="/main.css" />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />

    <!-- Bootstrap CSS -->
    <link
      rel="stylesheet"
      href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.1/css/bootstrap.min.css"
    />
    <title>Portfolio</title>
  </head>
  <body>
    <div class="frame">
      <div class="main_frame">
        <div class="left_frame">
          <div class="left_1">
            <div class="left_1-1">
              <img
                src="images/profile.png"
                width="156px"
                height="142px"
                alt="bu yerda rasm bor"
              />
            </div>
            <div class="left_1-2"><%=user.name%></div>
            <div class="left_1-3"><%=user.profession%></div>
            <div class="left-icons">
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Icons-dribbble.svg" class="icon-1" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Facebook.svg" class="icon-1" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Instagram.svg" class="icon-1" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Linkeding.svg" class="icon-1" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Twitter.svg" class="icon-1" />
                </div>
              </a>
              <a class="link_href" href="">
                <div class="icon">
                  <img src="icon/Youtube.svg" class="icon-1" />
                </div>
              </a>
            </div>
          </div>

          <div class="marginer"></div>

          <!-- AGE / RESIDENCE / FREELANCE / ADDRESS -->
          <div class="left_2">
            <div class="info-row">
              <span class="info-label">Age:</span>
              <span class="info-value">24</span>
            </div>
            <div class="info-row">
              <span class="info-label">Residence:</span>
              <span class="info-value">BD</span>
            </div>
            <div class="info-row">
              <span class="info-label">Freelance:</span>
              <span class="info-value text-green">Available</span>
            </div>
            <div class="info-row">
              <span class="info-label">Address:</span>
              <span class="info-value">Dhaka, Bangladesh</span>
            </div>
          </div>

          <div class="marginer"></div>

          <!-- LANGUAGES -->
          <div class="left_3">
            <h3 class="section-title">Languages</h3>

            <div class="lang-row">
              <div class="lang-info">
                <span>Bangla</span>
                <span>100%</span>
              </div>
              <div class="progress-bg">
                <div class="progress-fill" style="width: 100%"></div>
              </div>
            </div>

            <div class="lang-row">
              <div class="lang-info">
                <span>English</span>
                <span>80%</span>
              </div>
              <div class="progress-bg">
                <div class="progress-fill" style="width: 80%"></div>
              </div>
            </div>

            <div class="lang-row">
              <div class="lang-info">
                <span>Spanish</span>
                <span>60%</span>
              </div>
              <div class="progress-bg">
                <div class="progress-fill" style="width: 60%"></div>
              </div>
            </div>
          </div>

          <div class="marginer"></div>

          <!-- SKILLS -->
          <div class="left_4">
            <h3 class="section-title">Skills</h3>

            <div class="lang-row">
              <div class="lang-info">
                <span>Html</span>
                <span>90%</span>
              </div>
              <div class="progress-bg">
                <div class="progress-fill" style="width: 90%"></div>
              </div>
            </div>

            <div class="lang-row">
              <div class="lang-info">
                <span>CSS</span>
                <span>85%</span>
              </div>
              <div class="progress-bg">
                <div class="progress-fill" style="width: 85%"></div>
              </div>
            </div>

            <div class="lang-row">
              <div class="lang-info">
                <span>Js</span>
                <span>80%</span>
              </div>
              <div class="progress-bg">
                <div class="progress-fill" style="width: 80%"></div>
              </div>
            </div>

            <div class="lang-row">
              <div class="lang-info">
                <span>PHP</span>
                <span>75%</span>
              </div>
              <div class="progress-bg">
                <div class="progress-fill" style="width: 75%"></div>
              </div>
            </div>

            <div class="lang-row">
              <div class="lang-info">
                <span>WordPress</span>
                <span>85%</span>
              </div>
              <div class="progress-bg">
                <div class="progress-fill" style="width: 85%"></div>
              </div>
            </div>
          </div>

          <div class="marginer"></div>

          <!-- EXTRA SKILLS + DOWNLOAD CV -->
          <div class="left_5">
            <h3 class="section-title">Extra Skills</h3>

            <ul class="extra-list">
              <li><i class="fa fa-code"></i> Bootstrap, Materialize</li>
              <li><i class="fa fa-code"></i> Stylus, Sass, Less</li>
              <li><i class="fa fa-code"></i> Gulp, Webpack, Grunt</li>
              <li><i class="fa fa-code"></i> GIT Knowledge</li>
            </ul>

            <a href="#" class="download-btn">
              DOWNLOAD CV <i class="fa fa-download"></i>
            </a>
          </div>

          <div class="marginer"></div>
        </div>

        <!-- O'RTA QISM -->
        <div class="midd_frame">
          <!-- HERO -->
          <div class="hero">
            <div class="hero-text">
              <h1>
                I'm <%=user.name%><br />
                <span class="highlight"><%=user.profession%></span>
              </h1>
              <p><%=user.service_desc%></p>
              <a href="#" class="hire-btn"
                >HIRE ME <i class="fa fa-arrow-right"></i
              ></a>
            </div>
            <div class="hero-image">
              <img src="images/yourimage.svg" alt="profil rasmi" />
            </div>
          </div>

          <!-- SERVICES -->
          <div class="services">
            <h2>My Services</h2>
            <p class="services-desc">
              Amet Minim Mollit Non Deserunt Ullamco Est Sit Aliqua Dolor Do
              Amet Sint. Velit Officia Consequat Duis Enim Velit Mollit. Lorem
              Ipsum
            </p>

            <div class="services-grid">
              <div class="service-card">
                <img src="btn_icon/coding.svg" alt="icon coding" />
                <h4>Web Development</h4>
                <p>Blog, E-Commerce</p>
              </div>
              <div class="service-card">
                <img src="btn_icon/illustration.svg" alt="icon coding" />
                <h4>UI/UX Design</h4>
                <p>Mobile App, Website Design</p>
              </div>
              <div class="service-card">
                <img src="btn_icon/Microphone.svg" alt="icon coding" />
                <h4>Sound Design</h4>
                <p>Voice Over, Beat Making</p>
              </div>
              <div class="service-card">
                <img src="btn_icon/game-development.svg" alt="icon coding" />
                <h4>Game Design</h4>
                <p>Character Design, Props & Objects</p>
              </div>
              <div class="service-card">
                <img src="btn_icon/Photographer.svg" alt="icon coding" />
                <h4>Photography</h4>
                <p>Portrait, Product Photography</p>
              </div>
              <div class="service-card advertising-card">
                <h4>Advertising</h4>
                <p>
                  Lorem Ipsum Dolor Sit Amet, Consectetur Adipiscing Elit. Vitae
                  Nulla Diam In Ac Dictum A Urna Viverra Morbi.
                </p>
                <a href="#" class="order-link">ORDER NOW &gt;</a>
              </div>
            </div>
          </div>
        </div>

        <!-- O'NG NAVIGATSIYA -->
        <div class="right_frame">
          <div class="nav-icon active">
            <img src="btn_icon/Home.svg" alt="icon coding" />
          </div>
          <div class="nav-icon">
            <img src="btn_icon/Services.svg" alt="icon coding" />
          </div>
          <div class="nav-icon">
            <img src="btn_icon/cv.svg" alt="icon coding" />
          </div>
          <div class="nav-icon">
            <img src="btn_icon/Portfolio.svg" alt="icon coding" />
          </div>
          <div class="nav-icon">
            <img src="btn_icon/Blog.svg" alt="icon coding" />
          </div>
          <div class="nav-icon">
            <img src="btn_icon/Contact.svg" alt="icon coding" />
          </div>
        </div>
      </div>
    </div>

    <!-- Skriptlar oxirida, tartib bilan -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
  </body>
</html>
